{
  "schema_version": 1,
  "example_only": true,
  "board_id": "example-board",
  "capabilities": {
    "receipt": "synthetic-discovery-example",
    "observed_at": "2026-10-28",
    "fields": [
      {
        "id": "industry-field",
        "semantic": "industry",
        "enabled": true,
        "allowed_values": [
          "Financial Services",
          "Pharmaceuticals"
        ]
      },
      {
        "id": "domain-field",
        "semantic": "account_domain",
        "enabled": true
      },
      {
        "id": "name-field",
        "semantic": "account_name",
        "enabled": true,
        "replacement": true,
        "token": "{!account_name}"
      }
    ]
  },
  "required_roles": [
    "hero",
    "logos",
    "performance",
    "values",
    "leading",
    "workflow",
    "customer_context",
    "resources",
    "close"
  ],
  "header": {
    "navigation": [
      "Overview",
      "Resources"
    ],
    "cta": "Talk with us"
  },
  "industry_rules": [
    {
      "field_id": "industry-field",
      "value": "Financial Services",
      "variant": "banking"
    },
    {
      "field_id": "industry-field",
      "value": "Pharmaceuticals",
      "variant": "pharma"
    }
  ],
  "logo_rules": [
